package com.example.exp6spinner;

import android.app.AlertDialog;
import android.os.Bundle;
import android.widget.*;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    Spinner spinnerCity;
    Button btnAlert, btnPopup, btnToast;

    String[] cities = {"Kolhapur", "Sangli", "Pune", "Mumbai"};

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        spinnerCity = findViewById(R.id.spinnerCity);
        btnAlert = findViewById(R.id.btnAlert);
        btnPopup = findViewById(R.id.btnPopup);
        btnToast = findViewById(R.id.btnToast);

        ArrayAdapter<String> adapter = new ArrayAdapter<>(
                this,
                android.R.layout.simple_spinner_item,
                cities
        );

        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
        spinnerCity.setAdapter(adapter);

        spinnerCity.setOnItemSelectedListener(new AdapterView.OnItemSelectedListener() {
            @Override
            public void onItemSelected(AdapterView<?> parent, android.view.View view, int position, long id) {
                Toast.makeText(MainActivity.this,
                        "Selected: " + cities[position],
                        Toast.LENGTH_SHORT).show();
            }

            @Override
            public void onNothingSelected(AdapterView<?> parent) {
            }
        });

        btnAlert.setOnClickListener(v -> {
            AlertDialog.Builder builder = new AlertDialog.Builder(this);
            builder.setTitle("Alert");
            builder.setMessage("This is Alert Dialog");
            builder.setPositiveButton("OK", null);
            builder.show();
        });

        btnPopup.setOnClickListener(v -> {
            AlertDialog.Builder builder = new AlertDialog.Builder(this);
            builder.setTitle("Popup");
            builder.setMessage("This is Simple Popup Message");
            builder.setPositiveButton("OK", null);
            builder.show();
        });

        btnToast.setOnClickListener(v ->
                Toast.makeText(this, "This is Toast Message", Toast.LENGTH_SHORT).show()
        );
    }
}
